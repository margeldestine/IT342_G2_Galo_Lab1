<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Profile"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FF8A65"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="USERNAME" android:textColor="#F06292" android:textSize="12sp" android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvProfileUsername"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Loading..."
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="15dp"
            android:textColor="#333333"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EMAIL" android:textColor="#F06292" android:textSize="12sp" android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Loading..."
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="15dp"
            android:textColor="#333333"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIRST NAME" android:textColor="#F06292" android:textSize="12sp" android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvProfileFirstName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Loading..."
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="15dp"
            android:textColor="#333333"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAST NAME" android:textColor="#F06292" android:textSize="12sp" android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvProfileLastName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Loading..."
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="30dp"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/btnDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Dashboard"
            android:backgroundTint="#F06292"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:backgroundTint="#FFCC80"/>

    </LinearLayout>
</ScrollView>